# Godot's generated cache: it records absolute machine paths. Never commit it.
.godot/
# tsx for godot/tools, installed by `npm run godot:reference` (package-lock.json is committed).
tools/node_modules/
# The repository's root .gitignore ignores every folder named tools/; this one is source.
!/tools/
# Builds (npm run godot:export) and the playthroughs' pictures: rebuildable, never committed.
export/
# The build id npm run godot:export writes (net/build_info.gd), and the uid Godot gives it.
/build_id.gd
/build_id.gd.uid
