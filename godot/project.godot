; Going Down, on the Godot engine. Plain text: agents and people can read and edit it.
; So far this project holds the game's rules (sim/) and the tests that prove they behave exactly
; like the TypeScript rules in src/sim (tests/). See README.md for the commands.
config_version=5

[application]
config/name="Going Down"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]
; Typed GDScript throughout: a declaration without a type is a compile error, not a warning.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[rendering]
; The Compatibility renderer is the one that runs in a browser.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
