{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/hub/talk.mjs\" read --as claude --hook",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Reading the other agent's messages"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/hub/ns-hook.mjs\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking the brief against the North Star"
          }
        ]
      }
    ]
  }
}
