; Going Down, on the Godot engine. Plain text: agents and people can read and edit it.
; The game: the rules (sim/, proved the same as the TypeScript rules in src/sim by tests/), the
; client that draws and plays them (client/, assets/, data/, main.tscn; copied from
; spikes/godot-client by tools/sync_client.mjs), and the bridge between them (client/rules_bridge.gd,
; proved the same as the interim TypeScript host by tests/ref_bridge.gd). See README.md.
config_version=5

[application]
config/name="Going Down"
run/main_scene="res://main.tscn"
; The dedicated server build (export preset "Linux Server", feature "server") starts the server instead.
run/main_scene.server="res://server/server.tscn"
; The server prints each log line at once, so `docker logs` shows who joined as it happens.
run/flush_stdout_on_print.server=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]
; The Voice, Entity, Scare, Effects, Ambience and UI buses are declared in this file. Never add buses at run time
; (AudioServer.add_bus): in the browser's Sample playback mode that silences everything.
buses/default_bus_layout="res://default_bus_layout.tres"
driver/mix_rate.web=44100

[debug]
; The server writes no files (no log files either): it logs to standard output only.
file_logging/enable_file_logging.server=false
; Typed GDScript throughout: a declaration without a type is a compile error, not a warning.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[rendering]
; The Compatibility renderer is the one that runs in a browser.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
limits/opengl/max_lights_per_object=16
limits/opengl/max_renderable_lights=256
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
anti_aliasing/quality/msaa_3d=0
