{
  "name": "going-down",
  "version": "0.0.1",
  "private": true,
  "description": "A co-op suspense game for the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:hub",
    "e2e": "playwright test",
    "scan": "node hub/scan-secrets.mjs --all",
    "deploy:live": "node scripts/deploy-live.mjs",
    "test:hub": "node hub/smoke.mjs",
    "e2e:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "godot:reference": "node godot/tools/godot.mjs reference",
    "godot:test": "node godot/tools/godot.mjs test",
    "godot:golden": "node godot/tools/godot.mjs golden",
    "godot:export": "node godot/tools/godot.mjs export",
    "godot:promote": "node scripts/promote-godot.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "trystero": "0.27.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
